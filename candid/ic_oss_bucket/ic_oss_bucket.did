    ) query;
  lookup_folder_share_code : (LookupFolderShareCodeInput) -> (Result_45) query;
  move_file : (MoveInput, opt blob) -> (Result_46);
  move_folder : (MoveInput, opt blob) -> (Result_46);
  oauth_begin : (OAuthBeginInput) -> (Result_47);
  oauth_complete : (OAuthCompleteInput) -> (Result_48);
  // Reads exactly one chunk from an expected immutable file generation.
  read_file_chunk : (ReadFileChunkInput, opt blob) -> (Result_49) query;
  // Reads a bounded byte range from an expected immutable file generation.
  read_file_range : (ReadFileRangeInput, opt blob) -> (Result_49) query;
  renew_upload : (AbortUploadInput, opt blob) -> (Result_50);
  report_share_message : (ReportShareMessageInput) -> (Result_21);
  resolve_encryption_zone : (nat32, opt blob) -> (Result_51) query;
  resolve_encryption_zones : (vec nat32, opt blob) -> (Result_52) query;
  resolve_folder_share : (ResolveFolderShareInput) -> (Result_53) query;
  retract_sent_share_message : (ShareMessageMutationInput) -> (Result_21);
  retry_share_message_confirmations : (MigrateDirectoryStorageInput) -> (
