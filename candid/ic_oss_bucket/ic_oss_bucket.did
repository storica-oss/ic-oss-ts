};
type EntryCursor = record {
  id : nat32;
  kind : EntryKind;
  parent_revision : nat64;
};
type EntryInfoV2 = record {
  id : nat32;
  status : int8;
  updated_at : nat64;
  hash : opt blob;
  kind : EntryKind;
  name : text;
  size : opt nat64;
  content_type : opt text;
  created_at : nat64;
  filled : opt nat64;
  revision : nat64;
  parent : nat32;
};
type EntryKind = variant { Folder; File };
type EntryRef = record { id : nat32; kind : EntryKind };
// # Environment Variable.
type EnvironmentVariable = record {
  // Value of the environment variable.
  value : text;
  // Name of the environment variable.
  name : text;
};
// The immutable media-read metadata exposed to an authorized reader.
//
// It intentionally excludes upload/admin fields such as the parent directory,
// custom metadata and encrypted data key.  Clients must pass `generation` to
// every protected byte-read call so a replacement cannot mix old and new
// content in one media stream.
type FileDescriptor = record {
  id : nat32;
  hash : opt blob;
  size : nat64;
  generation : nat64;
  content_type : text;
  chunks : nat32;
  chunk_size : nat32;
};
// A Bucket keeps a bounded, per-principal set of file favorites. The entry is
// optional so a user can still see and remove a favorite after the underlying
// file was deleted or their read permission changed.
type FileFavorite = record {
  entry : opt EntryInfoV2;
  favorited_at_ms : nat64;
  file_id : nat32;
};
type FileInfo = record {
  ex : opt vec record { text; MetadataValue };
  id : nat32;
  dek : opt blob;
  status : int8;
  updated_at : nat64;
  custom : opt vec record { text; MetadataValue };
  hash : opt blob;
  name : text;
  size : nat64;
  generation : nat64;
  encryption : opt EncryptionInfoV1;
  content_type : text;
  created_at : nat64;
  filled : nat64;
  chunks : nat32;
  revision : nat64;
  parent : nat32;
};
type FileKeyEnvelopeV1 = record {
  cipher : ContentCipher;
  aad_hash : blob;
  version : nat16;
  nonce : blob;
  wrapped_dek : blob;
};
type FolderInfo = record {
  id : nat32;
  files : vec nat32;
  status : int8;
  updated_at : nat64;
  name : text;
  folders : vec nat32;
  created_at : nat64;
  revision : nat64;
  parent : nat32;
};
type FolderName = record { id : nat32; name : text };
type FolderShare = record {
  status : FolderShareStatus;
  access : ShareAccessMode;
  title : text;
  share_id : blob;
  updated_at_ms : nat64;
  created_by : principal;
  created_at_ms : nat64;
  root_folder : nat32;
  revision : nat64;
  revoked_at_ms : opt nat64;
  expires_at_ms : nat64;
};
type FolderShareCredential = record { share_id : blob; secret : blob };
type FolderShareError = variant {
  Internal : text;
  InvalidInput : text;
  EncryptedZone;
  NotFound;
  Unavailable;
  LimitExceeded : text;
  RangeOutOfBounds : text;
  Conflict : text;
};
type FolderShareStatus = variant { Active; Revoked; Expired };
type FolderShareView = record {
  access : ShareAccessMode;
  title : text;
  share_id : blob;
  root_folder : nat32;
  revision : nat64;
  expires_at_ms : nat64;
};
type GcHealth = record {
  pending_chunks : nat64;
  pending_items : nat64;
  oldest_enqueued_at : opt nat64;
};
type GetEntryInput = record { name : text; parent : nat32 };
type GetUploadStatusInput = record {
  session_id : blob;
  take : opt nat16;
  start : opt nat32;
};
type HttpReadMode = variant { TokenProtected; Disabled; Public; Legacy };
type InitArgs = record {
  governance_canister : opt principal;
  name : text;
  max_custom_data_size : nat16;
  encryption_writes : opt bool;
  vetkd_derivation : opt bool;
  max_children : nat16;
  enable_hash_index : bool;
  max_file_size : nat64;
  visibility : nat8;
  max_folder_depth : nat8;
  file_id : nat32;
};
type InitializeEncryptionZoneKeyInput = record {
  envelope : ZoneKeyEnvelopeV1;
  zone_id : blob;
  expected_revision : nat64;
};
type IssueMarketListingTicketInput = record {
  request_id : blob;
  market_request_id : blob;
  share_id : blob;
  market : principal;
  expected_share_revision : nat64;
};
type KeyPolicy = variant { VaultManaged; OwnerOnly };
type KeyProviderRef = variant {
  BucketVetkd : record { bucket : principal };
  VaultVetkd : record { vault : principal; vault_id : blob; key_ref : blob };
};
type ListEntriesInput = record {
  cursor : opt EntryCursor;
  take : opt nat16;
  parent : nat32;
};
type ListEntriesOutput = record {
  next : opt EntryCursor;
  entries : vec EntryInfoV2;
  parent_revision : nat64;
};
type ListFileFavoritesInput = record { cursor : opt nat32; take : opt nat16 };
type ListFileFavoritesOutput = record {
  favorites : vec FileFavorite;
  next : opt nat32;
};
type ListFolderSharesInput = record {
  cursor : opt blob;
  take : opt nat16;
  include_inactive : opt bool;
};
type ListFolderSharesOutput = record {
  shares : vec FolderShare;
  next : opt blob;
};
type ListShareMessagesInput = record {
  include_deleted : opt bool;
  cursor : opt ShareMessageCursor;
  origin : opt ShareMessageOriginKind;
  take : opt nat16;
};
type ListShareMessagesOutput = record {
