  share_get_file_descriptor : (ShareFileInput) -> (Result_56) query;
  share_list_entries : (ShareListEntriesInput) -> (Result_57) query;
  share_read_file_chunk : (ShareReadFileChunkInput) -> (Result_58) query;
  share_read_file_range : (ShareReadFileRangeInput) -> (Result_58) query;
