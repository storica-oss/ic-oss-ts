type RetryShareMessageConfirmationsOutput = record {
  attempted : nat16;
  remaining : nat64;
  confirmed : nat16;
};
type RevokeFolderShareInput = record {
  request_id : blob;
  share_id : blob;
  expected_revision : opt nat64;
};
type RevokeReaderGrantInput = record {
  request_id : blob;
  subject : principal;
  entitlement_version : nat64;
};
type RotateFolderShareSecretInput = record {
  request_id : blob;
  share_id : blob;
  secret_hash : blob;
  expected_revision : opt nat64;
  // Replaces the previous short-code index. `None` disables short-code
  // lookup for this share after rotation.
  share_code_hash : opt blob;
};
type SetDriftBottleChannelInput = record {
  request_id : blob;
  bottle_id : nat64;
  publisher : principal;
  expected_channel_revision : nat64;
  enabled : bool;
};
type SetFileFavoriteInput = record { favorite : bool; file_id : nat32 };
type SetFolderShareMessagesInput = record {
  request_id : blob;
  share_id : blob;
  expected_channel_revision : opt nat64;
  enabled : bool;
};
type SetShareMessageSenderBlockInput = record {
  request_id : blob;
  blocked : bool;
  sender : principal;
};
type SetWebsiteConfigInput = record { root_name : opt text; enabled : bool };
type ShareAccessMode = variant {
  Authenticated;
  AnyoneWithLink;
  Principals : vec principal;
};
type ShareFileInput = record {
  credential : FolderShareCredential;
  file_id : nat32;
};
type ShareListEntriesInput = record {
  credential : FolderShareCredential;
  cursor : opt EntryCursor;
  take : opt nat16;
  parent : nat32;
};
type ShareListEntriesOutput = record {
  next : opt EntryCursor;
  entries : vec SharedEntryInfo;
  parent_revision : nat64;
};
type ShareMessageChannel = record {
  key : ShareMessageChannelKey;
  share_revision : opt nat64;
  share_id : opt blob;
  updated_at_ms : nat64;
  created_by : principal;
  created_at_ms : nat64;
  enabled : bool;
  deadline_ms : opt nat64;
  revision : nat64;
};
type ShareMessageChannelKey = variant {
  DirectShare : blob;
  DriftBottle : record { bottle_id : nat64; market : principal };
};
type ShareMessageCursor = record {
  key : ShareMessageKey;
  reverse_created_at : nat64;
};
type ShareMessageError = variant {
  Internal : text;
  InvalidInput : text;
  AnonymousNotAllowed;
  Duplicate;
  InboxFull;
  ChannelClosed;
  NotFound;
  Unauthorized;
  SafetyCheckRequired;
  SafetyCheckUnavailable;
  SenderBlocked;
  Unavailable;
  ExternalAuthorizationUnavailable;
  DailyLimitExceeded;
  Conflict : text;
};
type ShareMessageKey = variant {
  DirectShare : record { share_id : blob; sender : principal };
  DriftBottle : record { catch_id : nat64; market : principal };
};
type ShareMessageMutationInput = record {
  key : ShareMessageKey;
  request_id : blob;
};
type ShareMessageOrigin = variant {
  DirectShare : ResolveFolderShareInput;
  DriftBottle : record {
    bottle_id : nat64;
    catch_id : nat64;
    market : principal;
  };
};
type ShareMessageOriginKind = variant { DirectShare; DriftBottle };
type ShareMessageOriginView = variant {
  DirectShare : record { share_id : blob; share_title : text };
  DriftBottle : record {
    bottle_id : nat64;
    catch_id : nat64;
    market : principal;
  };
};
type ShareReadFileChunkInput = record {
  credential : FolderShareCredential;
  read : ReadFileChunkInput;
};
type ShareReadFileRangeInput = record {
  credential : FolderShareCredential;
  read : ReadFileRangeInput;
};
type ShareSubtreeManifestInput = record {
  credential : FolderShareCredential;
  cursor : opt SubtreeManifestCursor;
  take : opt nat16;
};
type ShareSubtreeManifestOutput = record {
  next : opt SubtreeManifestCursor;
  entries : vec SharedManifestEntry;
  revision : nat64;
};
type SharedEntryInfo = record {
  id : nat32;
  hash : opt blob;
  kind : EntryKind;
  name : text;
  size : opt nat64;
  generation : opt nat64;
  content_type : opt text;
  revision : nat64;
  parent : nat32;
};
type SharedFolderInfo = record { id : nat32; name : text; revision : nat64 };
type SharedManifestEntry = record { path : text; entry : SharedEntryInfo };
type SubmitShareMessageInput = record {
  request_id : blob;
  body : text;
  origin : ShareMessageOrigin;
  // Reserved for a signed semantic-moderation proof. Rule-only experimental
  // buckets reject non-empty proofs until a verifier configuration exists.
  safety_attestation : opt blob;
};
type SubtreeManifestCursor = record {
  stack : vec ManifestFrame;
  revision : nat64;
};
type SubtreeManifestInput = record {
  cursor : opt SubtreeManifestCursor;
  root : nat32;
  take : opt nat16;
};
type SubtreeManifestOutput = record {
  next : opt SubtreeManifestCursor;
  entries : vec ManifestEntry;
  revision : nat64;
};
type SupportedStandard = record { url : text; name : text };
type SyncError = variant {
  Internal : text;
  InvalidInput : text;
  NotFound : text;
  PermissionDenied : text;
  Unauthorized : text;
  LimitExceeded : text;
  Conflict : record { entries : vec EntryRef; message : text };
};
type TextValue = record { content : text };
type TokenAmount = record { decimals : nat8; amount : nat64; symbol : text };
type TransferCyclesInput = record { to_canister : principal; amount : nat };
type TransferCyclesOutput = record {
  transferred : nat;
  remaining_balance : nat;
};
type UpdateBucketInput = record {
  status : opt int8;
  reader_policy : opt ReaderPolicy;
  trusted_eddsa_pub_keys : opt vec blob;
  name : opt text;
  max_custom_data_size : opt nat16;
  http_read_mode : opt HttpReadMode;
  encryption_writes : opt bool;
  vetkd_derivation : opt bool;
  max_children : opt nat16;
  enable_hash_index : opt bool;
  max_file_size : opt nat64;
  visibility : opt nat8;
  max_folder_depth : opt nat8;
  trusted_ecdsa_pub_keys : opt vec blob;
};
type UpdateFileChunkInput = record {
  id : nat32;
  chunk_index : nat32;
  content : blob;
};
type UpdateFileChunkOutput = record { updated_at : nat64; filled : nat64 };
type UpdateFileInput = record {
  id : nat32;
  status : opt int8;
  custom : opt vec record { text; MetadataValue };
  hash : opt blob;
  name : opt text;
  size : opt nat64;
  content_type : opt text;
};
type UpdateFileOutput = record { updated_at : nat64 };
type UpdateFolderInput = record {
  id : nat32;
  status : opt int8;
  name : opt text;
};
type UpdateFolderShareInput = record {
  request_id : blob;
  access : opt ShareAccessMode;
  title : opt text;
  share_id : blob;
  expected_revision : opt nat64;
  expires_at_ms : opt nat64;
};
type UpdateShareMessageSafetyInput = record {
  config : opt ContentSafetyVerifierConfig;
};
type UpgradeArgs = record {
  governance_canister : opt principal;
  max_custom_data_size : opt nat16;
  encryption_writes : opt bool;
  vetkd_derivation : opt bool;
  max_children : opt nat16;
  enable_hash_index : opt bool;
  max_file_size : opt nat64;
  max_folder_depth : opt nat8;
};
type UploadChunkInput = record {
  request_id : blob;
  chunk_index : nat32;
  content : blob;
  session_id : blob;
};
type UploadChunkOutput = record {
  filled : nat64;
  expires_at : nat64;
  uploaded_chunks : nat32;
};
type UploadHealth = record {
  active_sessions : nat64;
  max_active_sessions : nat16;
};
type UploadStatusOutput = record {
  total_chunks : nat32;
  next : opt nat32;
  size : nat64;
  generation : nat64;
  filled : nat64;
  ranges : vec UploadedChunkRange;
  expires_at : nat64;
  uploaded_chunks : nat32;
  file_id : nat32;
};
type UploadedChunkRange = record {
  // Inclusive last chunk index.
  end : nat32;
  // Inclusive first chunk index.
  start : nat32;
};
type UpsertReaderGrantInput = record {
  request_id : blob;
  subject : principal;
  entitlement_version : nat64;
  expires_at_ms : opt nat64;
};
type WebsiteConfig = record {
  root_name : text;
  enabled : bool;
  folder_id : opt nat32;
};
type ZoneKeyEnvelopeV1 = record {
  provider : KeyProviderRef;
  key_version : nat32;
  cipher : ContentCipher;
  aad_hash : blob;
  protection : ZoneKeyProtection;
  version : nat16;
  nonce : blob;
  wrapped_zwk : blob;
};
type ZoneKeyProtection = variant { VetkdAndPassword; VetkdOnly };
service : (opt CanisterArgs) -> {
  abort_upload : (AbortUploadInput, opt blob) -> (Result);
