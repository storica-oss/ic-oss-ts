  update_file_chunk : (UpdateFileChunkInput, opt blob) -> (Result_60);
  update_file_info : (UpdateFileInput, opt blob) -> (Result_46);
  update_folder_info : (UpdateFolderInput, opt blob) -> (Result_46);
  update_folder_share : (UpdateFolderShareInput) -> (Result_19);
  upload_chunk : (UploadChunkInput, opt blob) -> (Result_61);
  validate2_admin_set_auditors : (vec principal) -> (Result_62);
  validate2_admin_set_custom_domains : (vec text) -> (Result_62);
  validate2_admin_set_managers : (vec principal) -> (Result_62);
  validate2_admin_update_bucket : (UpdateBucketInput) -> (Result_62);
