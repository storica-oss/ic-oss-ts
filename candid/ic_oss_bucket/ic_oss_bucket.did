  set_file_favorite : (SetFileFavoriteInput, opt blob) -> (Result_20);
  set_folder_share_messages : (SetFolderShareMessagesInput) -> (Result_32);
  set_share_message_sender_block : (SetShareMessageSenderBlockInput) -> (
