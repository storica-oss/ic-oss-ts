      InitializeEncryptionZoneKeyInput,
      opt blob,
    ) -> (Result_8);
  is_caller_controller : () -> (bool) query;
  issue_market_listing_ticket : (IssueMarketListingTicketInput) -> (Result_34);
  list_entries : (ListEntriesInput, opt blob) -> (Result_41) query;
  list_file_favorites : (ListFileFavoritesInput, opt blob) -> (Result_42) query;
  list_files : (nat32, opt nat32, opt nat32, opt blob) -> (Result_43) query;
  list_folder_shares : (ListFolderSharesInput) -> (
