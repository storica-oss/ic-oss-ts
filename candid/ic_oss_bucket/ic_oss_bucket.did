type AbortUploadInput = record { request_id : blob; session_id : blob };
type ArchiveEncryptionZoneInput = record {
  zone_id : blob;
  expected_revision : nat64;
};
type BatchCreateSmallFilesInput = record {
  files : vec CreateFileInput;
  request_id : blob;
};
type BatchCreateSmallFilesOutput = record { results : vec Result_9 };
type BatchEnsureFoldersInput = record {
  request_id : blob;
  folders : vec CreateFolderInput;
};
type BatchEnsureFoldersOutput = record { results : vec Result_12 };
type BatchUpsertReaderGrantsInput = record {
  request_id : blob;
  grants : vec ReaderGrantSpec;
};
type BatchUpsertReaderGrantsOutput = record { results : vec Result_2 };
type BeginUploadInput = record {
  dek : opt blob;
  request_id : blob;
  status : int8;
  custom : opt vec record { text; MetadataValue };
  hash : opt blob;
  expected_parent_revision : nat64;
  name : text;
  size : nat64;
  encryption : opt EncryptionInfoV1;
  content_type : text;
  replace : opt ReplaceFileInput;
  parent : nat32;
};
type BeginUploadOutput = record {
  total_chunks : nat32;
  session_id : blob;
  generation : nat64;
  chunk_size : nat32;
  expires_at : nat64;
  file_id : nat32;
};
type BucketCapabilities = record {
  batch_operations : opt bool;
  folder_shares : opt bool;
  share_manifest : opt bool;
  reader_grants : opt bool;
  api_version : nat16;
  bucket_vetkd : opt bool;
  encryption_zones : opt bool;
  incremental_gc : bool;
  migration_state : MigrationState;
  file_favorites : opt bool;
  share_messages_v1 : opt bool;
  encryption_format_version : opt nat16;
  ensure_folder : bool;
  storage_metrics : opt bool;
  conditional_delete : bool;
  encryption_writes : opt bool;
  unique_names : bool;
  market_bottle_inbox : opt bool;
  vetkd_derivation : opt bool;
  get_entry : bool;
  http_read_modes : opt bool;
  storage_version : nat16;
  manifest : bool;
  atomic_commit : bool;
  upload_sessions : bool;
};
type BucketInfo = record {
  status : int8;
  reader_policy : opt ReaderPolicy;
  total_chunks : nat64;
  trusted_eddsa_pub_keys : vec blob;
  managers : vec principal;
  governance_canister : opt principal;
  name : text;
  max_custom_data_size : nat16;
  auditors : vec principal;
  // Present on buckets that support isolated public website hosting.
  website : opt WebsiteConfig;
  http_read_mode : opt HttpReadMode;
  // Enables Zone creation and mutations inside Encryption Zones.
  encryption_writes : opt bool;
  total_files : nat64;
  // Emergency switch for VetKD derivation. Disabling this also prevents
  // recovery of existing ciphertext and should only be temporary.
  vetkd_derivation : opt bool;
  max_children : nat16;
  enable_hash_index : bool;
  max_file_size : nat64;
  folder_id : nat32;
  visibility : nat8;
  max_folder_depth : nat8;
  trusted_ecdsa_pub_keys : vec blob;
  total_folders : nat64;
  file_id : nat32;
};
// Capacity signals reported by the Bucket itself. Stable-memory remaining
// space is necessarily an estimate: the platform limit is fixed per canister,
// while successful growth also depends on subnet capacity and cycle reserves.
type BucketStorageMetrics = record {
  total_memory_size : nat64;
  vetkd_cycles_attached : opt nat;
  encryption_zones : opt nat64;
  vetkd_derive_attempts : opt nat64;
  stable_memory_size : nat64;
  // Spendable cycles currently held by the Bucket.
  cycles : opt nat;
  vetkd_derive_in_flight : opt nat32;
  vetkd_derive_rejections : opt nat64;
  stable_memory_limit : nat64;
  vetkd_derive_successes : opt nat64;
  wasm_memory_size : nat64;
  memory_allocation : nat64;
  vetkd_derive_failures : opt nat64;
  // Cycles reserved by the subnet for future storage payments.
  reserved_cycles : opt nat;
};
type CanisterArgs = variant { Upgrade : UpgradeArgs; Init : InitArgs };
// # Canister Status Result
//
// Result type of [`canister_status`](https://internetcomputer.org/docs/current/references/ic-interface-spec/#ic-canister_status).
type CanisterStatusResult = record {
  // The detailed metrics on the memory consumption of the canister.
  memory_metrics : MemoryMetrics;
  // Status of the canister.
  status : CanisterStatusType;
  // The memory size taken by the canister.
  memory_size : nat;
  // Indicates whether a stopped canister is ready to be migrated to another subnet
  // (i.e., whether it has empty queues and flushed streams).
  ready_for_migration : bool;
  // The canister version.
  version : nat64;
  // The cycle balance of the canister.
  cycles : nat;
  // Canister settings in effect.
  settings : DefiniteCanisterSettings;
  // Query statistics.
  query_stats : QueryStats;
  // Amount of cycles burned per day.
  idle_cycles_burned_per_day : nat;
  // A SHA256 hash of the module installed on the canister. This is null if the canister is empty.
  module_hash : opt blob;
  // The reserved cycles balance of the canister.
  //
  // These are cycles that are reserved by the resource reservation mechanism on storage allocation.
  // See also the [`CanisterSettings::reserved_cycles_limit`] parameter in canister settings.
  reserved_cycles : nat;
};
// # Canister Status Type
//
// Status of a canister.
//
// See [`CanisterStatusResult::status`].
type CanisterStatusType = variant {
  // The canister is stopped.
  stopped;
  // The canister is stopping.
  stopping;
  // The canister is running.
  running;
};
type CollectFolderShareGarbageOutput = record {
  remaining_shares : nat64;
  remaining_replays : nat64;
  removed_shares : nat16;
  removed_replays : nat16;
};
type CollectGarbageInput = record {
  // Maximum number of chunk slots to process in this call.
  max_chunks : opt nat32;
};
type CollectGarbageOutput = record {
  removed_chunks : nat32;
  remaining_items : nat64;
  processed_chunks : nat32;
  completed_items : nat32;
  remaining_chunks : nat64;
};
type CollectMarketListingGarbageOutput = record {
  removed_tickets : nat16;
  remaining_tickets : nat64;
};
type CollectShareMessageGarbageOutput = record {
  remaining_messages : nat64;
  removed_messages : nat16;
  remaining_body_bytes : nat64;
};
type CommitUploadOutput = record {
  id : nat32;
  created : bool;
  committed_at : nat64;
  generation : nat64;
  revision : nat64;
};
type ConsentError = variant {
  GenericError : record { description : text; error_code : nat };
  InsufficientPayment : ConsentErrorInfo;
  UnsupportedCanisterCall : ConsentErrorInfo;
  ConsentMessageUnavailable : ConsentErrorInfo;
};
type ConsentErrorInfo = record { description : text };
type ConsentInfo = record {
  metadata : ConsentMessageMetadata;
  consent_message : ConsentMessage;
};
type ConsentMessage = variant {
  FieldsDisplayMessage : record {
    fields : vec record { text; ConsentValue };
    intent : text;
  };
  GenericDisplayMessage : text;
};
type ConsentMessageDeviceSpec = variant { GenericDisplay; FieldsDisplay };
type ConsentMessageMetadata = record {
  utc_offset_minutes : opt int16;
  language : text;
};
type ConsentMessageRequest = record {
  arg : blob;
  method : text;
  user_preferences : ConsentMessageSpec;
};
type ConsentMessageResponse = variant { Ok : ConsentInfo; Err : ConsentError };
type ConsentMessageSpec = record {
  metadata : ConsentMessageMetadata;
  device_spec : opt ConsentMessageDeviceSpec;
};
type ConsentValue = variant {
  Text : TextValue;
  TokenAmount : TokenAmount;
  TimestampSeconds : DurationSeconds;
  DurationSeconds : DurationSeconds;
};
type ConsumeMarketListingTicketInput = record {
  request_id : blob;
  ticket : blob;
  credential : FolderShareCredential;
  bottle_id : nat64;
  publisher : principal;
};
type ConsumedMarketListing = record {
  share_revision : nat64;
  listing_manifest_revision : nat64;
  bottle_id : nat64;
  share_id : blob;
  publisher : principal;
  channel_revision : nat64;
  market : principal;
  bucket : principal;
  share_title : text;
  share_expires_at_ms : nat64;
};
type ContentCipher = variant { XChaCha20Poly1305 };
type ContentSafetyMode = variant { Required; RuleOnly };
type ContentSafetyPublicKey = record {
  public_key : blob;
  key_id : text;
  not_before_ms : nat64;
  expires_at_ms : nat64;
};
type ContentSafetyVerifierConfig = record {
  text_policy_version : text;
  clock_skew_ms : nat64;
  max_attestation_ttl_ms : nat64;
  keys : vec ContentSafetyPublicKey;
  mode : ContentSafetyMode;
  policy_version : text;
};
type CreateEncryptionZoneInput = record {
  request_id : blob;
  root_folder_id : nat32;
  zone_id : blob;
  parent_zone_id : opt blob;
};
type CreateFileInput = record {
  dek : opt blob;
  status : opt int8;
  content : opt blob;
  custom : opt vec record { text; MetadataValue };
  hash : opt blob;
  name : text;
  size : opt nat64;
  encryption : opt EncryptionInfoV1;
  content_type : text;
  parent : nat32;
};
type CreateFileOutput = record { id : nat32; created_at : nat64 };
type CreateFolderInput = record { name : text; parent : nat32 };
type CreateFolderShareInput = record {
  request_id : blob;
  access : ShareAccessMode;
  title : text;
  share_id : blob;
  root_folder : nat32;
  secret_hash : blob;
  // Opaque, canister-scoped hash of an optional human-friendly share code.
  // The plaintext code is never persisted by the canister.
  share_code_hash : opt blob;
  expires_at_ms : nat64;
};
// # Definite Canister Settings
//
// Represents the actual settings in effect.
//
// For return of [`canister_status`](https://internetcomputer.org/docs/current/references/ic-interface-spec/#ic-canister_status).
type DefiniteCanisterSettings = record {
  // Time in seconds after which the canister is considered frozen.
  freezing_threshold : nat;
  // Threshold on the remaining wasm memory size of the canister in bytes.
  wasm_memory_threshold : nat;
  // A list of environment variables.
  environment_variables : vec EnvironmentVariable;
  // Controllers of the canister.
  controllers : vec principal;
  // Upper limit on [`CanisterStatusResult::reserved_cycles`] of the canister.
  reserved_cycles_limit : nat;
  // Visibility of canister logs.
  log_visibility : LogVisibility;
  // Upper limit on the memory used for canister logs (bytes).
  log_memory_limit : nat;
  // Upper limit on the WASM heap memory (bytes) consumption of the canister.
  wasm_memory_limit : nat;
  // Total memory (bytes) the canister is allowed to use.
  memory_allocation : nat;
  // Guaranteed compute allocation as a percentage of the maximum compute power that a single canister can allocate.
  compute_allocation : nat;
};
type DeleteEntryIfInput = record {
  id : nat32;
  request_id : blob;
  kind : EntryKind;
  expected_parent : nat32;
  expected_hash : opt blob;
  expected_revision : nat64;
};
type DeriveZoneKeyInput = record {
  expected_key_version : nat32;
  zone_id : blob;
  transport_public_key : blob;
};
type DerivedZoneKey = record {
  encrypted_key : blob;
  provider : KeyProviderRef;
  key_version : nat32;
  public_key : blob;
};
type DirectoryStorageHealth = record {
  migration_error : opt text;
  stable_folders : nat64;
  duplicate_names : nat64;
  legacy_folders : nat64;
  stable_names : nat64;
  stable_children : nat64;
  dangling_entries : nat64;
};
type DomainConfig = record {
  derivation_origin : text;
  custom_domains : vec text;
  canister_id : principal;
};
type DurationSeconds = record { amount : nat64 };
type EncryptionInfoV1 = record {
  nonce_prefix : blob;
  plaintext_size : nat64;
  envelope : FileKeyEnvelopeV1;
  object_id : blob;
  cipher : ContentCipher;
  version : nat16;
  plaintext_chunk_size : nat32;
  zone_id : blob;
};
type EncryptionProfile = record {
  updated_at : nat64;
  root_zone_id : opt blob;
  created_at : nat64;
  enabled : bool;
};
type EncryptionZone = record {
  root_folder_id : nat32;
  updated_at : nat64;
  key_envelopes : vec ZoneKeyEnvelopeV1;
  owner : principal;
  created_at : nat64;
  state : EncryptionZoneState;
  zone_id : blob;
  revision : nat64;
  active_envelope : opt nat16;
  parent_zone_id : opt blob;
  policy : KeyPolicy;
};
type EncryptionZoneState = variant { PendingInitialization; Active; Archived };
type EnsureFolderInput = record {
  request_id : blob;
