  revoke_folder_share : (RevokeFolderShareInput) -> (Result_19);
  rotate_folder_share_secret : (RotateFolderShareSecretInput) -> (Result_19);
  set_drift_bottle_message_channel : (SetDriftBottleChannelInput) -> (
