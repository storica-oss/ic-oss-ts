  admin_set_reader_authority : (opt principal) -> (Result_1);
  admin_set_website_config : (SetWebsiteConfigInput) -> (Result_5);
  admin_set_website_enabled : (bool) -> (Result_5);
  admin_transfer_cycles : (TransferCyclesInput) -> (Result_6);
  admin_update_bucket : (UpdateBucketInput) -> (Result_1);
  admin_update_share_message_safety : (UpdateShareMessageSafetyInput) -> (
      Result_7,
    );
  admin_upsert_reader_grant : (UpsertReaderGrantInput) -> (Result_2);
  api_version : () -> (nat16) query;
  archive_encryption_zone : (ArchiveEncryptionZoneInput, opt blob) -> (
      Result_8,
    );
  batch_create_small_files : (BatchCreateSmallFilesInput, opt blob) -> (
      Result_10,
    );
  batch_delete_subfiles : (nat32, vec nat32, opt blob) -> (Result_11);
  batch_ensure_folders : (BatchEnsureFoldersInput, opt blob) -> (Result_13);
  begin_upload : (BeginUploadInput, opt blob) -> (Result_14);
  collect_folder_share_garbage : (MigrateDirectoryStorageInput) -> (
      CollectFolderShareGarbageOutput,
    );
  collect_garbage : (CollectGarbageInput, opt blob) -> (Result_15);
  collect_market_listing_garbage : (MigrateDirectoryStorageInput) -> (
      CollectMarketListingGarbageOutput,
    );
  collect_share_message_garbage : (MigrateDirectoryStorageInput) -> (
      CollectShareMessageGarbageOutput,
    );
  commit_upload : (AbortUploadInput, opt blob) -> (Result_16);
  consume_market_listing_ticket : (ConsumeMarketListingTicketInput) -> (
      Result_17,
    );
  create_child_encryption_zone : (CreateEncryptionZoneInput, opt blob) -> (
      Result_8,
    );
  create_file : (CreateFileInput, opt blob) -> (Result_18);
  create_folder : (CreateFolderInput, opt blob) -> (Result_18);
  create_folder_share : (CreateFolderShareInput) -> (Result_19);
  create_root_encryption_zone : (CreateEncryptionZoneInput, opt blob) -> (
      Result_8,
    );
  delete_entry_if : (DeleteEntryIfInput, opt blob) -> (Result);
  delete_file : (nat32, opt blob) -> (Result_20);
  delete_folder : (nat32, opt blob) -> (Result_20);
  delete_my_share_message : (ShareMessageMutationInput) -> (Result_21);
  derive_zone_key : (DeriveZoneKeyInput, opt blob) -> (Result_22);
  ensure_folder : (EnsureFolderInput, opt blob) -> (Result_12);
  get_bucket_info : (opt blob) -> (Result_23) query;
  get_canister_status : () -> (Result_24);
  get_capabilities : () -> (BucketCapabilities) query;
  get_directory_storage_health : (opt blob) -> (Result_25) query;
  get_domain_config : () -> (DomainConfig) query;
  get_encryption_zone : (blob, opt blob) -> (Result_8) query;
  get_entry : (GetEntryInput, opt blob) -> (Result_26) query;
  get_file_ancestors : (nat32, opt blob) -> (Result_27) query;
  get_file_chunks : (nat32, nat32, opt nat32, opt blob) -> (Result_28) query;
  // Returns the media-safe immutable description of a fully committed file.
  // Reader grants are sufficient for this endpoint, but do not expose any
  // directory metadata.
  get_file_descriptor : (nat32, opt blob) -> (Result_29) query;
  // Lightweight star-state projection for directory/file views. Unlike the
  // detailed favorites page this performs no file metadata reads and returns at
  // most the per-user hard limit of 1,000 ids.
  get_file_favorite_ids : () -> (Result_11) query;
  get_file_info : (nat32, opt blob) -> (Result_30) query;
  get_file_info_by_hash : (blob, opt blob) -> (Result_30) query;
  get_folder_ancestors : (nat32, opt blob) -> (Result_27) query;
  get_folder_info : (nat32, opt blob) -> (Result_31) query;
  get_folder_share : (blob) -> (Result_19) query;
  get_folder_share_message_channel : (blob) -> (Result_32) query;
  get_gc_health : (opt blob) -> (Result_33) query;
  get_market_listing_ticket : (blob) -> (Result_34) query;
  get_my_encryption_profile : (opt blob) -> (Result_35) query;
  get_my_reader_grant : () -> (Result_36) query;
  get_oauth_config : () -> (OAuthPublicConfig) query;
  get_share_message_safety_config : () -> (
      opt ContentSafetyVerifierConfig,
    ) query;
  // Returns the storage-only subset of canister status and accepts the same
  // delegated access token as directory reads. The legacy full status endpoint
  // remains unchanged for existing clients.
  get_storage_metrics : (opt blob) -> (Result_37);
  get_subtree_manifest : (SubtreeManifestInput, opt blob) -> (Result_38) query;
  get_upload_health : (opt blob) -> (Result_39) query;
  get_upload_status : (GetUploadStatusInput, opt blob) -> (Result_40) query;
  icrc10_supported_standards : () -> (vec SupportedStandard) query;
  icrc21_canister_call_consent_message : (ConsentMessageRequest) -> (
      ConsentMessageResponse,
    );
